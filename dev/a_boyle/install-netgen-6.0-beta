#! /bin/bash

echo "last tested: 2017-04-18 with Ubuntu xenial 16.04.2 LTS, also Gentoo Linux"
echo "run $(date)"

SFDL=https://sourceforge.net/projects

# versions to install
# TCL
TCLVER=8.6.6
# Tix
TIXVER=8.4.3
# Togl
TOGLVER=1.7
#NetGen version
NGVER=$(basename $0)
NGVER=${NGVER#*-}
NGVER=${NGVER#*-}
NGVER2=${NGVER%-*}
echo "netgen install version: ${NGVER} -> ${NGVER2}"
# local install
SRCDIR=${SRCDIR:-${HOME}/netgen-${NGVER}-src}
INSTDIR=${INSTDIR:-${HOME}/netgen-${NGVER}}

MAKE="make -j$(( $(nproc --all) +1 ))"

# TK version should probably match TCL version
TKVER=${TCLVER}

CFLAGS="$CFLAGS -I${INSTDIR}/include"
CPPFLAGS="$CPPFLAGS ${CFLAGS}"

function err() {
  echo "$(basename $0) ERROR: $1"
  exit 1
}

set -e
set -x

# install dependencies
# liboce is for OpenCASCADE support (IGES/STEP CAD file formats)
[ "x$(grep DISTRIB_ID /etc/lsb-release | sed 's/.*=//')" != "xUbuntu" ] || \
   sudo apt install libxmu-dev mesa-common-dev libglu1-mesa-dev libx11-dev python2-dev \
      liboce-foundation-dev liboce-foundation11 liboce-modeling-dev liboce-modeling11 liboce-ocaf-dev \
      liboce-ocaf-lite-dev liboce-ocaf-lite11 liboce-ocaf11 liboce-visualization-dev liboce-visualization11


# ${MAKE} working directories if they don't exist
mkdir -p ${SRCDIR}
mkdir -p ${INSTDIR}
export PATH="${INSTDIR}/bin:${PATH}"

# get files
cd ${SRCDIR}
[ -f tcl${TCLVER}-src.tar.gz ] || wget ${SFDL}/tcl/files/tcl${TCLVER}-src.tar.gz
[ -f tk${TKVER}-src.tar.gz ]   || wget ${SFDL}/tcl/files/tk${TKVER}-src.tar.gz
[ -f Tix${TIXVER}-src.tar.gz ] || wget ${SFDL}/tix/files/tix/${TIXVER}/Tix${TIXVER}-src.tar.gz
[ -f Togl-${TOGLVER}.tar.gz ]  || wget ${SFDL}/togl/files/Togl/${TOGLVER}/Togl-${TOGLVER}.tar.gz
[ -f netgen-${NGVER}.tar.gz ]  || wget ${SFDL}/netgen-mesher/files/netgen-mesher/${NGVER2}/netgen-${NGVER}.tar.gz

# unpack files
tar zxvf tcl${TCLVER}-src.tar.gz > /dev/null
tar zxvf tk${TKVER}-src.tar.gz > /dev/null
tar zxvf Tix${TIXVER}-src.tar.gz > /dev/null
tar zxvf Togl-${TOGLVER}.tar.gz > /dev/null
tar zxvf netgen-${NGVER}.tar.gz > /dev/null

# build tcl
cd ${SRCDIR}/tcl${TCLVER}/unix
./configure --prefix=${INSTDIR} --enable-threads --enable-shared --enable-64bit
${MAKE}
${MAKE} install

# build tk
cd ${SRCDIR}/tk${TKVER}/unix
./configure --prefix=${INSTDIR} --with-tcl=${INSTDIR}/lib --enable-threads --enable-shared --enable-64bit
${MAKE}
${MAKE} install

# build tix
cd ${SRCDIR}/Tix${TIXVER}
cat > tix-8.4.3-tcl8.6.patch << EOF
--- a/generic/tixGrSort.c
+++ b/generic/tixGrSort.c
@@ -447,8 +447,8 @@ SortCompareProc(first, second)
 	 * Parse the result of the command.
 	 */
 
-	order = strtol(sortInterp->result, &end, 0);
-	if ((end == sortInterp->result) || (*end != 0)) {
+	order = strtol(Tcl_GetStringResult(sortInterp), &end, 0);
+	if ((end == Tcl_GetStringResult(sortInterp)) || (*end != 0)) {
 	    Tcl_ResetResult(sortInterp);
 	    Tcl_AppendResult(sortInterp,
 		    "comparison command returned non-numeric result",
EOF
patch -p1 < tix-8.4.3-tcl8.6.patch
./configure --prefix=${INSTDIR} --with-tcl=${INSTDIR}/lib --with-tk=${INSTDIR}/lib --enable-threads --enable-shared --enable-64bit
${MAKE}
${MAKE} install


# build Togl
cd ${SRCDIR}/Togl-${TOGLVER}
./configure --prefix=${INSTDIR} --with-tcl=${INSTDIR}/lib --with-tk=${INSTDIR}/lib  --enable-threads --enable-shared --enable-64bit
${MAKE}
${MAKE} install

ln -s ${INSTDIR}/lib/Togl${TOGLVER}/libTogl${TOGLVER}.so ${INSTDIR}/lib/libTogl${TOGLVER}.so
ln -s ${INSTDIR}/lib/libTogl${TOGLVER}.so                ${INSTDIR}/lib/libTogl.so

# build NetGen
cd ${SRCDIR}/netgen-${NGVER}

# TODO update for 6.0-beta? or maybe it still can be applied successfully
cat > netgen-5.3-opencascade.patch << EOF
--- /libsrc/occ/occgeom.hpp	2017-02-09 01:34:38.172433886 -0500
+++ /libsrc/occ/occgeom.hpp	2017-02-09 01:34:45.283479486 -0500
@@ -385,7 +385,7 @@
       void GetNotDrawableFaces (stringstream & str);
       bool ErrorInSurfaceMeshing ();
 
-     void WriteOCC_STL(char * filename);
+//     void WriteOCC_STL(char * filename);
 
      virtual int GenerateMesh (Mesh*& mesh, MeshingParameters & mparam, 
          int perfstepsstart, int perfstepsend);
--- /libsrc/occ/occgeom.cpp	2017-02-09 01:34:58.975567262 -0500
+++ /libsrc/occ/occgeom.cpp	2017-02-09 01:35:15.709674497 -0500
@@ -1033,7 +1033,7 @@
 
 
 
-
+#if 0
    void OCCGeometry :: WriteOCC_STL(char * filename)
    {
       cout << "writing stl..."; cout.flush();
@@ -1045,7 +1045,7 @@
 
       cout << "done" << endl;
    }
-
+#endif
 
 
    // Philippose - 23/02/2009
EOF
patch -p1 < netgen-5.3-opencascade.patch

# TODO update for 6.0-beta? or maybe it still can be applied successfully
cat > configure.patch << 'EOF'
--- /configure 2022-09-12 12:41:40.191862149 -0400
+++ /configure 2022-09-12 12:52:41.154330028 -0400
@@ -15780,7 +15780,7 @@
 # split strings by '.' and convert to numeric.  Append some zeros
 # because we need at least 4 digits for the hex conversion.
 # map returns an iterator in Python 3.0 and a list in 2.x
-minver = list(map(int, '3.2'.split('.'))) + [0, 0, 0]
+minver = list(map(int, '3.1'.split('.'))) + [0, 0, 0]
 minverhex = 0
 # xrange is not present in Python 3.0 and range returns an iterator
 for i in list(range(0, 4)): minverhex = (minverhex << 8) + minver[i]
@@ -15811,7 +15811,7 @@
 # split strings by '.' and convert to numeric.  Append some zeros
 # because we need at least 4 digits for the hex conversion.
 # map returns an iterator in Python 3.0 and a list in 2.x
-minver = list(map(int, '3.2'.split('.'))) + [0, 0, 0]
+minver = list(map(int, '3.1'.split('.'))) + [0, 0, 0]
 minverhex = 0
 # xrange is not present in Python 3.0 and range returns an iterator
 for i in list(range(0, 4)): minverhex = (minverhex << 8) + minver[i]
@@ -15916,6 +15916,7 @@
 
             { $as_echo "$as_me:${as_lineno-$LINENO}: checking for $am_display_PYTHON script directory" >&5
 $as_echo_n "checking for $am_display_PYTHON script directory... " >&6; }
+DEPWARN="import warnings; warnings.simplefilter('ignore', category=DeprecationWarning)"
 if ${am_cv_python_pythondir+:} false; then :
   $as_echo_n "(cached) " >&6
 else
@@ -15925,7 +15926,7 @@
      else
        am_py_prefix=$prefix
      fi
-     am_cv_python_pythondir=`$PYTHON -c "import sys; from distutils import sysconfig; sys.stdout.write(sysconfig.get_python_lib(0,0,prefix='$am_py_prefix'))" 2>/dev/null`
+     am_cv_python_pythondir=`$PYTHON -c "$DEPWARN; import sys; from distutils import sysconfig; sys.stdout.write(sysconfig.get_python_lib(0,0,prefix='$am_py_prefix'))" 2>/dev/null`
      case $am_cv_python_pythondir in
      $am_py_prefix*)
        am__strip_prefix=`echo "$am_py_prefix" | sed 's|.|.|g'`
@@ -15962,7 +15963,7 @@
      else
        am_py_exec_prefix=$exec_prefix
      fi
-     am_cv_python_pyexecdir=`$PYTHON -c "import sys; from distutils import sysconfig; sys.stdout.write(sysconfig.get_python_lib(1,0,prefix='$am_py_exec_prefix'))" 2>/dev/null`
+     am_cv_python_pyexecdir=`$PYTHON -c "$DEPWARN; import sys; from distutils import sysconfig; sys.stdout.write(sysconfig.get_python_lib(1,0,prefix='$am_py_exec_prefix'))" 2>/dev/null`
      case $am_cv_python_pyexecdir in
      $am_py_exec_prefix*)
        am__strip_prefix=`echo "$am_py_exec_prefix" | sed 's|.|.|g'`
@@ -16079,19 +16080,19 @@
 	#
 	# if the macro parameter ``version'' is set, honour it
 	#
-	if test -n ">= '3.2'"; then
-		{ $as_echo "$as_me:${as_lineno-$LINENO}: checking for a version of Python >= '3.2'" >&5
-$as_echo_n "checking for a version of Python >= '3.2'... " >&6; }
+	if test -n ">= '3.1'"; then
+		{ $as_echo "$as_me:${as_lineno-$LINENO}: checking for a version of Python >= '3.1'" >&5
+$as_echo_n "checking for a version of Python >= '3.1'... " >&6; }
 		ac_supports_python_ver=`$PYTHON -c "import sys; \
 			ver = sys.version.split ()[0]; \
-			print (ver >= '3.2')"`
+			print (ver >= '3.1')"`
 		if test "$ac_supports_python_ver" = "True"; then
 		   { $as_echo "$as_me:${as_lineno-$LINENO}: result: yes" >&5
 $as_echo "yes" >&6; }
 		else
 			{ $as_echo "$as_me:${as_lineno-$LINENO}: result: no" >&5
 $as_echo "no" >&6; }
-			as_fn_error $? "this package requires Python >= '3.2'.
+			as_fn_error $? "this package requires Python >= '3.1'.
 If you have it installed, but it isn't the default Python
 interpreter in your system path, please pass the PYTHON_VERSION
 variable to configure. See \`\`configure --help'' for reference.
@@ -16105,7 +16106,7 @@
 	#
 	{ $as_echo "$as_me:${as_lineno-$LINENO}: checking for the distutils Python package" >&5
 $as_echo_n "checking for the distutils Python package... " >&6; }
-	ac_distutils_result=`$PYTHON -c "import distutils" 2>&1`
+	ac_distutils_result=`$PYTHON -c "$DEPWARN; import distutils" 2>&1`
 	if test -z "$ac_distutils_result"; then
 		{ $as_echo "$as_me:${as_lineno-$LINENO}: result: yes" >&5
 $as_echo "yes" >&6; }
@@ -16124,9 +16125,9 @@
 	{ $as_echo "$as_me:${as_lineno-$LINENO}: checking for Python include path" >&5
 $as_echo_n "checking for Python include path... " >&6; }
 	if test -z "$PYTHON_CPPFLAGS"; then
-		python_path=`$PYTHON -c "import distutils.sysconfig; \
+		python_path=`$PYTHON -c "$DEPWARN; import distutils.sysconfig; \
 			print (distutils.sysconfig.get_python_inc ());"`
-		plat_python_path=`$PYTHON -c "import distutils.sysconfig; \
+		plat_python_path=`$PYTHON -c "$DEPWARN; import distutils.sysconfig; \
 			print (distutils.sysconfig.get_python_inc (plat_specific=1));"`
 		if test -n "${python_path}"; then
 			if test "${plat_python_path}" != "${python_path}"; then
@@ -16153,7 +16154,7 @@
 
 # join all versioning strings, on some systems
 # major/minor numbers could be in different list elements
-from distutils.sysconfig import *
+$DEPWARN; from distutils.sysconfig import *
 e = get_config_var('VERSION')
 if e is not None:
 	print(e)
@@ -16179,7 +16180,7 @@
 		ac_python_libdir=`cat<<EOD | $PYTHON -
 
 # There should be only one
-import distutils.sysconfig
+$DEPWARN; import distutils.sysconfig
 e = distutils.sysconfig.get_config_var('LIBDIR')
 if e is not None:
 	print (e)
@@ -16188,7 +16189,7 @@
 		# Now, for the library:
 		ac_python_library=`cat<<EOD | $PYTHON -
 
-import distutils.sysconfig
+$DEPWARN; import distutils.sysconfig
 c = distutils.sysconfig.get_config_vars()
 if 'LDVERSION' in c:
 	print ('python'+c['LDVERSION'])
@@ -16208,7 +16209,7 @@
 		else
 			# old way: use libpython from python_configdir
 			ac_python_libdir=`$PYTHON -c \
-			  "from distutils.sysconfig import get_python_lib as f; \
+			  "$DEPWARN; from distutils.sysconfig import get_python_lib as f; \
 			  import os; \
 			  print (os.path.join(f(plat_specific=1, standard_lib=1), 'config'));"`
 			PYTHON_LDFLAGS="-L$ac_python_libdir -lpython$ac_python_version"
@@ -16231,7 +16232,7 @@
 	{ $as_echo "$as_me:${as_lineno-$LINENO}: checking for Python site-packages path" >&5
 $as_echo_n "checking for Python site-packages path... " >&6; }
 	if test -z "$PYTHON_SITE_PKG"; then
-		PYTHON_SITE_PKG=`$PYTHON -c "import distutils.sysconfig; \
+		PYTHON_SITE_PKG=`$PYTHON -c "$DEPWARN; import distutils.sysconfig; \
 			print (distutils.sysconfig.get_python_lib(0,0));"`
 	fi
 	{ $as_echo "$as_me:${as_lineno-$LINENO}: result: $PYTHON_SITE_PKG" >&5
@@ -16244,7 +16245,7 @@
 	{ $as_echo "$as_me:${as_lineno-$LINENO}: checking python extra libraries" >&5
 $as_echo_n "checking python extra libraries... " >&6; }
 	if test -z "$PYTHON_EXTRA_LIBS"; then
-	   PYTHON_EXTRA_LIBS=`$PYTHON -c "import distutils.sysconfig; \
+	   PYTHON_EXTRA_LIBS=`$PYTHON -c "$DEPWARN; import distutils.sysconfig; \
                 conf = distutils.sysconfig.get_config_var; \
                 print (conf('LIBS') + ' ' + conf('SYSLIBS'))"`
 	fi
@@ -16258,7 +16259,7 @@
 	{ $as_echo "$as_me:${as_lineno-$LINENO}: checking python extra linking flags" >&5
 $as_echo_n "checking python extra linking flags... " >&6; }
 	if test -z "$PYTHON_EXTRA_LDFLAGS"; then
-		PYTHON_EXTRA_LDFLAGS=`$PYTHON -c "import distutils.sysconfig; \
+		PYTHON_EXTRA_LDFLAGS=`$PYTHON -c "$DEPWARN; import distutils.sysconfig; \
 			conf = distutils.sysconfig.get_config_var; \
 			print (conf('LINKFORSHARED'))"`
 	fi
EOF
read -n1 -r -p "Press any key to continue..."
patch -p1 < configure.patch


[ ! -f /usr/lib/x86_64-linux-gnu/libTKIGES.so ] || OCC="--enable-occ"

CPPFLAGS=${CPPFLAGS} CFLAGS=${CFLAGS} ./configure --prefix=${INSTDIR} --with-tcl=${INSTDIR}/lib --with-tk=${INSTDIR}/lib --with-togl=${INSTDIR}/lib --with-tclinclude=${INSTDIR}/include ${OCC}
${MAKE}
${MAKE} install

# clean up
cd
rm -rf "${SRCDIR}/tcl${TCLVER}"
rm -rf "${SRCDIR}/tk${TKVER}"
rm -rf "${SRCDIR}/Tix${TIXVER}"
rm -rf "${SRCDIR}/Togl-${TOGLVER}"
rm -rf "${SRCDIR}/netgen-${NGVER}"
#cp "$0" "${SRCDIR}"

# fix path issues
mv ${INSTDIR}/bin/netgen ${INSTDIR}/bin/netgen-exec
echo "#! /bin/sh
D=${INSTDIR}/bin
L=${INSTDIR}/lib
PATH="\$D:\$PATH" LD_LIBRARY_PATH=\$L NETGENDIR=\$D \$D/netgen-exec \$*
" > ${INSTDIR}/bin/netgen
chmod +x ${INSTDIR}/bin/netgen

set +x
set +e

cat <<EOF
compile completed $(date)

run netgen with '${INSTDIR}/bin/netgen'
EOF
